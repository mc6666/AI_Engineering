{
  "name": "photo-organizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "drizzle-kit migrate",
    "test:unit": "jest --testPathPattern=\"tests/unit\" --passWithNoTests",
    "test:integration": "jest --testPathPattern=\"tests/integration\" --passWithNoTests",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "bench:thumbnails": "ts-node --project tsconfig.scripts.json scripts/bench-thumbnails.ts",
    "fixtures:generate": "ts-node --project tsconfig.scripts.json scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "archiver": "^6.0.2",
    "better-sqlite3": "^9.6.0",
    "drizzle-orm": "^0.31.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.44.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.22.0",
    "eslint": "^9.0.0",
    "eslint-plugin-sonarjs": "^2.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.38",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
