# Copy this file to .env.local and adjust values for your environment.

# Absolute path to the data directory where photos and the SQLite database are stored.
# Defaults to <project_root>/data if not set.
DATA_DIR=./data

# Absolute path to the SQLite database file.
# Defaults to <DATA_DIR>/photos.db if not set.
DATABASE_URL=./data/photos.db

# Next.js port (optional, default 3000)
# PORT=3000
