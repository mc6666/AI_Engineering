/* Presentation theme: bold high-contrast chrome, large affordances, dark accent bar. */
QWidget { background-color: #1c1f26; color: #f5f5f5; font-size: 11pt; }
QToolBar { background-color: #11141a; border: none; spacing: 6px; }
QStatusBar { background-color: #11141a; color: #f5f5f5; }
QTreeWidget, QScrollArea { background-color: #262a33; color: #f5f5f5; }
QTabWidget::pane { border: 1px solid #3d4250; }
QPushButton { background-color: #2f7dde; color: white; border-radius: 3px; padding: 3px; }
